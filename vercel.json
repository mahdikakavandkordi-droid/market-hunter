{
  "version": 2,
  "functions": {
    "api/elliott.js": {
      "maxDuration": 20
    },
    "api/research-data.js": {
      "includeFiles": "data/{daily-market-report,market-pulse-report,v2-latest-scan}.json"
    },
    "api/engines.js": {
      "maxDuration": 20
    },
    "api/scan.js": {
      "maxDuration": 30
    },
    "api/telegram.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/scan",
      "destination": "/api/scan.js"
    }
  ],
  "ignoreCommand": "if { [ \"$VERCEL_GIT_COMMIT_REF\" = \"research/market-hunter-ui-work\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"research/market-hunter-ui-lite\" ]; } && ! printf '%s' \"$VERCEL_GIT_COMMIT_MESSAGE\" | grep -q '\\[deploy\\]'; then exit 0; else exit 1; fi",
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

